{
  "description": "Engram remote memory: injects the memory protocol and the project name at session start and after compaction. No local server or database.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh\"",
            "timeout": 5,
            "statusMessage": "Loading engram memory protocol..."
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}/scripts/post-compaction.sh\"",
            "timeout": 5,
            "statusMessage": "Recovering engram context after compaction..."
          }
        ]
      }
    ]
  }
}
