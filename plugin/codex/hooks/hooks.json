{
  "description": "Engram remote memory: protocol and project name at session start and after compaction.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear",
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/session-start.sh\"", "timeout": 5, "statusMessage": "Loading engram memory protocol..." }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          { "type": "command", "command": "\"${PLUGIN_ROOT}/scripts/post-compaction.sh\"", "timeout": 5, "statusMessage": "Recovering engram context after compaction..." }
        ]
      }
    ]
  }
}
